#pragma once

// Copy this file to secrets.h and replace with your device ID
// Capture your remote's device ID using RTL-SDR and URH
// Device ID is 48 bits (12 hex characters)
//
// Use rtl_433 command:
//   rtl_433 -f 433.017M -s 250k -g 40 -R 0 \
//     -X 'n=Watersnake,m=FSK_MC_ZEROBIT,s=52,l=104,r=200'

#define DEVICE_ID "000000000000"  // Replace with your device ID

// BLE pairing secret (8–64 characters). Leave empty for development (auth disabled).
// Must match the secret entered in the Waypoint app Settings screen.
#define BLE_AUTH_SECRET ""